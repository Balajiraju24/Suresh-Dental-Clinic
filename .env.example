# Google Apps Script Web App Endpoint for Public Appointment Form
# See GOOGLE_APPS_SCRIPT_SETUP.md for instructions on generating this URL
NEXT_PUBLIC_GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Firebase Client Configuration for Staff Management Portal
# Obtain these values from Firebase Console -> Project Settings -> General -> Your apps -> Web app
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=suresh-dental-clinic.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=suresh-dental-clinic
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=suresh-dental-clinic.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id

